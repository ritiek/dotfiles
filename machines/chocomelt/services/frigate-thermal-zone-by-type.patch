+def get_thermal_zone_temp(zone_type: str) -> float | None:
+    """Temperature in Celsius of the thermal zone with this type. Zone numbers
+    differ between SoCs: gpu-thermal is zone5 on RK3588 but zone1 on RK3566."""
+    base = "/sys/class/thermal"
+    try:
+        zones = [z for z in os.listdir(base) if z.startswith("thermal_zone")]
+    except OSError:
+        return None
+
+    for zone in zones:
+        try:
+            with open(f"{base}/{zone}/type") as f:
+                if f.read().strip() != zone_type:
+                    continue
+            with open(f"{base}/{zone}/temp") as f:
+                return round(int(f.read().strip()) / 1000, 1)
+        except (OSError, ValueError):
+            continue
+
+    return None
+
