#!/bin/sh
# Apply switchwrt's runtime secrets, read as key=value lines on stdin.
#
# The image is deliberately secret-free: nothing sensitive enters the Nix
# derivation, because the resulting image lives in the world-readable
# /nix/store and would leak anything baked into its rootfs.  Instead
# machines/switchwrt/deploy-secrets.sh decrypts machines/switchwrt/
# secrets.yaml on the operator's machine and pipes the values straight into
# this script over ssh.  Values therefore exist on this device only in this
# process's memory and in the files it deliberately writes.
#
# Expected keys (unknown keys are ignored, missing keys are skipped, so this
# is safe to run with a partial payload):
#
#   tailscale_authkey    -> /etc/tailscale/authkey   (mode 600, single-use)
#   netbird_setupkey     -> /etc/netbird/setupkey    (mode 600, single-use)
#   wifi_ap_psk          -> wireless.default_radio0.key, and clears the
#                           disabled flag 97-wifi-ap leaves set
#   root_password_hash   -> the hash field of root's /etc/shadow line
#
# Idempotent and safe to re-run: every action is a set-to-desired-state, and
# the VPN logins are no-ops once the node is registered.
#
# Usage (normally via deploy-secrets.sh, but by hand works too):
#   printf 'wifi_ap_psk=hunter2\n' | ssh root@192.168.3.1 switchwrt-apply-secrets

set -e

log() { logger -s -t apply-secrets "$@"; }

if [ -t 0 ]; then
	echo "error: expects key=value lines on stdin, refusing to read a tty" >&2
	exit 1
fi

tailscale_authkey=
netbird_setupkey=
wifi_ap_psk=
root_password_hash=

# IFS='=' with two read targets splits on the FIRST '=' only, so values may
# themselves contain '=' (base64-ish keys often do).  -r keeps backslashes
# literal.  Note this loop runs in the current shell, not a subshell, so the
# assignments below persist.
while IFS='=' read -r key value; do
	case "$key" in
		''|'#'*) continue ;;
		tailscale_authkey)  tailscale_authkey=$value ;;
		netbird_setupkey)   netbird_setupkey=$value ;;
		wifi_ap_psk)        wifi_ap_psk=$value ;;
		root_password_hash) root_password_hash=$value ;;
		*) log "ignoring unknown key: $key" ;;
	esac
done

applied=

# --- VPN keys -------------------------------------------------------------
# printf '%s' (no trailing newline) to match what the key files looked like
# when they were baked in: `tailscale up --auth-key=file:` and `netbird up
# --setup-key-file` both want the bare token.  umask so the file is never
# even briefly world-readable, rather than creating it 644 and chmod'ing.
write_key() {
	dir=$(dirname "$1")
	mkdir -p "$dir"
	chmod 700 "$dir"
	( umask 077; printf '%s' "$2" > "$1" )
}

if [ -n "$tailscale_authkey" ]; then
	write_key /etc/tailscale/authkey "$tailscale_authkey"
	applied="$applied tailscale_authkey"
fi

if [ -n "$netbird_setupkey" ]; then
	write_key /etc/netbird/setupkey "$netbird_setupkey"
	applied="$applied netbird_setupkey"
fi

# --- WiFi AP passphrase ---------------------------------------------------
# Piped into `uci batch` rather than passed as `uci set ...=$psk`, so the
# passphrase never appears in this process's argv (visible via /proc to any
# local reader) nor in shell history.
if [ -n "$wifi_ap_psk" ]; then
	printf "set wireless.default_radio0.key='%s'\nset wireless.default_radio0.disabled='0'\ncommit wireless\n" \
		"$wifi_ap_psk" | uci batch
	applied="$applied wifi_ap_psk"
fi

# --- root password --------------------------------------------------------
# Rewrites only field 2 of the root line, preserving every other field and
# the file's existing 0600 inode; no temp file, and the hash never reaches
# argv.  Safe with awk -v because crypt's alphabet is [A-Za-z0-9./$] with no
# backslashes, so there are no escape sequences for -v to reinterpret.
#
# Must be a sha512 ($6$) hash.  LuCI authenticates through rpcd, which calls
# crypt() from musl libc -- musl implements $1$, $5$, $6$ and $2b$ but NOT
# yescrypt, so a $y$ hash (which busybox's passwd applet would happily write)
# is accepted at write time and then silently fails every LuCI and console
# login.  deploy-secrets.sh checks the prefix before sending.
if [ -n "$root_password_hash" ]; then
	case "$root_password_hash" in
		'$6$'*) ;;
		*) log "refusing root_password_hash: expected a \$6\$ (sha512) hash"; exit 1 ;;
	esac
	if [ ! -f /etc/shadow ]; then
		log "refusing root_password_hash: /etc/shadow missing"
		exit 1
	fi
	shadow=$(awk -F: -v h="$root_password_hash" \
		'BEGIN { OFS = ":" } $1 == "root" { $2 = h } { print }' /etc/shadow)
	# Guard against writing a truncated file if awk produced nothing.
	if [ -z "$shadow" ]; then
		log "refusing root_password_hash: rewrite produced empty output"
		exit 1
	fi
	printf '%s\n' "$shadow" > /etc/shadow
	applied="$applied root_password_hash"
fi

if [ -z "$applied" ]; then
	log "no recognised keys on stdin, nothing to do"
	exit 0
fi

log "applied:$applied"

# --- bring things up ------------------------------------------------------
# `wifi reload` only if we touched wireless, and backgrounded because it
# tears down the AP -- which is fine over ssh (we arrive over eth1/br-lan or
# the tailnet) but would otherwise hold this script open for seconds.
if [ -n "$wifi_ap_psk" ]; then
	log "reloading wifi"
	wifi reload >/dev/null 2>&1 &
fi

# Kick the login one-shots.  Both are guarded internally: they return early
# if the node is already registered, so this is a no-op on re-runs.  Both are
# also single-use from the control plane's point of view, hence the key
# cleanup below.
if [ -n "$tailscale_authkey" ] && [ -x /etc/init.d/tailscale-login ]; then
	log "running tailscale-login"
	/etc/init.d/tailscale-login start >/dev/null 2>&1 || \
		log "tailscale-login returned non-zero (see logread -e tailscale)"
fi

if [ -n "$netbird_setupkey" ] && [ -x /etc/init.d/netbird-login ]; then
	log "running netbird-login"
	/etc/init.d/netbird-login start >/dev/null 2>&1 || \
		log "netbird-login returned non-zero (see logread -e netbird)"
fi

# --- discard the consumed enrolment keys ----------------------------------
# Both keys are single-use and worthless after registration; durable identity
# lives in /etc/tailscale/tailscaled.state and /root/.config/netbird, which
# persist on the overlay.  Removing them shrinks the window in which a
# reusable credential sits on flash.  Only remove once registration is
# actually confirmed, so a failed enrolment can be retried by re-running.
if [ -n "$tailscale_authkey" ]; then
	if [ "$(tailscale status --json 2>/dev/null | jsonfilter -e '@.BackendState' 2>/dev/null)" = "Running" ]; then
		rm -f /etc/tailscale/authkey
		log "tailscale registered; discarded authkey"
	else
		log "tailscale not yet Running; keeping authkey for a retry"
	fi
fi

if [ -n "$netbird_setupkey" ]; then
	if [ "$(netbird status --json 2>/dev/null | jsonfilter -e '@.management.connected' 2>/dev/null)" = "true" ]; then
		rm -f /etc/netbird/setupkey
		log "netbird registered; discarded setupkey"
	else
		log "netbird not yet connected; keeping setupkey for a retry"
	fi
fi

exit 0
