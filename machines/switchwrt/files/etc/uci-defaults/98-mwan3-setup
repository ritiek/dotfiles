#!/bin/sh
# mwan3 multi-WAN policy routing: three uplinks -- wan (eth1, wired, via
# switchboard -> the ONT), wwan (USB WiFi dongle, STA joining the ONT's own
# SSID directly; see files/etc/uci-defaults/97-wwan-uplink), and usbtether
# (phone USB tethering, untested; see
# files/etc/uci-defaults/97-usbtether-uplink) as a third, lowest-priority
# fallback for when travelling and neither of the other two is available.
#
# Automatic failover, eth1 preferred: both members sit in one policy at
# different metrics. mwan3's metric semantics ARE the failover logic --
# members at the lowest live metric are used (load-balanced by weight among
# ties), and a higher-metric member only takes over once every lower-metric
# member is down. There is no separate "failover policy type": this IS how
# failover is expressed.
#
# This is deliberately the ONLY policy/rule baked here (a single catch-all
# default_rule). Per-device pinning (route one specific device via one
# uplink or the other, by MAC) is meant to be configured afterward through
# the LuCI UI rather than declared here, since it is expected to change
# over time:
#   1. Network > DHCP and DNS > Static Leases -- bind the device's MAC to a
#      fixed IP.
#   2. Network > Load Balancing -- add a rule matching that IP as src_ip,
#      with use_policy set to 'wan_only' or 'wwan_only' (both already
#      defined below), placed above default_rule in the rule order.
#
# NOTE on rule/policy NAMES: mwan3 silently drops any policy or rule whose
# section name exceeds 15 characters (mwan3.sh: "Rule $1 exceeds max of 15
# chars. Not setting rule") -- the UCI section still exists and looks fine,
# but no iptables rule is ever rendered for it. Keep names short.

# The mwan3 package ships a complete example config in /etc/config/mwan3
# (interfaces wan/wan6/wanb/wanb6, ten members, balanced/wan_wanb/... 
# policies, and https/default_rule_v4/default_rule_v6 rules pointing at
# 'balanced'). Since mwan3 matches rules top-down and the shipped rules sit
# ABOVE anything we append here, they permanently shadow our default_rule:
# all traffic hit shipped default_rule_v4 -> 'balanced', whose only enabled
# member is wan -- so wwan failover never engaged, and our eth1_preferred
# policy sat unused at the bottom. Delete the shipped rules outright (the
# unused shipped interfaces/members/policies are left in place: harmless
# clutter, visible in LuCI, but shadowing nothing).
uci -q delete mwan3.https
uci -q delete mwan3.default_rule_v4
uci -q delete mwan3.default_rule_v6

# REQUIRED: every mwan3-managed interface needs a UNIQUE route metric in
# /etc/config/network. Without one, netifd installs each uplink's default
# route at metric 0, and identical (prefix, metric) routes collide in the
# kernel: whichever interface ifups LAST loses -- its default route simply
# never lands in the main table. mwan3track's probes are plain pings with
# SO_BINDTODEVICE + SO_MARK 0x3f00 ("use main table"), so the losing
# interface has NO route its probes can use -> every check fails ->
# permanently "offline" even though the link itself is perfectly healthy
# (seen live: wan flapped offline 30s after boot and never recovered while
# a pinned-route ping over eth1 had 0% loss; which uplink won the metric-0
# race varied per boot). With distinct metrics, all defaults coexist in the
# main table (metric 10 preferred by non-mwan3 lookups) and every tracker
# can always route its own probes.
uci set network.wan.metric='10'
uci set network.wwan.metric='20'
uci set network.usbtether.metric='30'
uci commit network

uci -q get mwan3.wan >/dev/null 2>&1 || uci set mwan3.wan=interface
uci set mwan3.wan.enabled='1'
uci set mwan3.wan.family='ipv4'
uci -q delete mwan3.wan.track_ip
uci add_list mwan3.wan.track_ip='1.1.1.1'
uci add_list mwan3.wan.track_ip='8.8.8.8'
uci set mwan3.wan.reliability='1'
uci set mwan3.wan.count='1'
uci set mwan3.wan.timeout='2'
uci set mwan3.wan.interval='5'
uci set mwan3.wan.down='3'
uci set mwan3.wan.up='3'

uci -q get mwan3.wwan >/dev/null 2>&1 || uci set mwan3.wwan=interface
uci set mwan3.wwan.enabled='1'
uci set mwan3.wwan.family='ipv4'
uci -q delete mwan3.wwan.track_ip
uci add_list mwan3.wwan.track_ip='1.1.1.1'
uci add_list mwan3.wwan.track_ip='8.8.8.8'
uci set mwan3.wwan.reliability='1'
uci set mwan3.wwan.count='1'
uci set mwan3.wwan.timeout='2'
uci set mwan3.wwan.interval='5'
uci set mwan3.wwan.down='3'
uci set mwan3.wwan.up='3'

uci set mwan3.wan_m1_w1=member
uci set mwan3.wan_m1_w1.interface='wan'
uci set mwan3.wan_m1_w1.metric='1'
uci set mwan3.wan_m1_w1.weight='1'

uci set mwan3.wwan_m2_w1=member
uci set mwan3.wwan_m2_w1.interface='wwan'
uci set mwan3.wwan_m2_w1.metric='2'
uci set mwan3.wwan_m2_w1.weight='1'

uci -q get mwan3.usbtether >/dev/null 2>&1 || uci set mwan3.usbtether=interface
uci set mwan3.usbtether.enabled='1'
uci set mwan3.usbtether.family='ipv4'
uci -q delete mwan3.usbtether.track_ip
uci add_list mwan3.usbtether.track_ip='1.1.1.1'
uci add_list mwan3.usbtether.track_ip='8.8.8.8'
uci set mwan3.usbtether.reliability='1'
uci set mwan3.usbtether.count='1'
uci set mwan3.usbtether.timeout='2'
uci set mwan3.usbtether.interval='5'
uci set mwan3.usbtether.down='3'
uci set mwan3.usbtether.up='3'

uci set mwan3.usbtether_m3_w1=member
uci set mwan3.usbtether_m3_w1.interface='usbtether'
uci set mwan3.usbtether_m3_w1.metric='3'
uci set mwan3.usbtether_m3_w1.weight='1'

uci set mwan3.wan_only=policy
uci -q delete mwan3.wan_only.use_member
uci add_list mwan3.wan_only.use_member='wan_m1_w1'

uci set mwan3.wwan_only=policy
uci -q delete mwan3.wwan_only.use_member
uci add_list mwan3.wwan_only.use_member='wwan_m2_w1'

uci set mwan3.usbtether_only=policy
uci -q delete mwan3.usbtether_only.use_member
uci add_list mwan3.usbtether_only.use_member='usbtether_m3_w1'

uci set mwan3.eth1_preferred=policy
uci -q delete mwan3.eth1_preferred.use_member
uci add_list mwan3.eth1_preferred.use_member='wan_m1_w1'
uci add_list mwan3.eth1_preferred.use_member='wwan_m2_w1'
uci add_list mwan3.eth1_preferred.use_member='usbtether_m3_w1'

# Tailnet traffic must bypass mwan3 entirely: use_policy='default' marks it
# 0x3f00 ("use the default/main routing table"), where ip rule 5270 sends
# 100.64.0.0/10 through tailscaled's own table 52 -> tailscale0. Without
# this, the catch-all below marks tailnet-bound packets for eth1 and
# replies to tailnet peers leak out the WAN instead of the tunnel (seen
# live: alcove could tailscale-ping switchwrt but got no ICMP replies;
# `ip route get 100.64.0.12` said via 192.168.2.1 dev eth1). Deleting +
# recreating default_rule keeps UCI ordering right: rules match top-down,
# so the exemption must sit above the catch-all. No IPv6 twin is needed:
# with shipped default_rule_v6 gone, mwan3 doesn't manage IPv6 at all, so
# tailscale's v6 range rides the main table naturally.
# (Name kept <= 15 chars, see NOTE above.)
uci set mwan3.ts_exempt=rule
uci set mwan3.ts_exempt.dest_ip='100.64.0.0/10'
uci set mwan3.ts_exempt.family='ipv4'
uci set mwan3.ts_exempt.use_policy='default'

uci -q delete mwan3.default_rule
uci set mwan3.default_rule=rule
uci set mwan3.default_rule.dest_ip='0.0.0.0/0'
uci set mwan3.default_rule.family='ipv4'
uci set mwan3.default_rule.use_policy='eth1_preferred'

uci commit mwan3

/etc/init.d/mwan3 enable

exit 0
