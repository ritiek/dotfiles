#!/bin/sh
# WiFi AP configuration for the AIC8800D80 (SDIO) radio on the Cubie A5E.
#
# Every value here is load-bearing -- see the notes below before changing any
# of them.  The reference for the known-good shape is the NixOS config this
# board normally runs: /etc/nixos/modules/wifi/hostapd_ap.nix
#
#   macaddr='94:ba:06:49:af:40' (NOT phy=, NOT path=)
#     The SDIO host controller this chip sits behind enumerates as mmc0 on
#     some boots and mmc1 on others, so a path= match is unstable.  phy
#     names are just as unstable once the RTL8192EU USB dongle is present:
#     phyN indexes are handed out in probe order, and SDIO-vs-USB probe
#     order varies across boots, which made radio0/radio1 swap roles
#     between the two chips ("the situation flipped" bug).  The burned-in
#     permanent MAC is the only identifier stable across boots AND
#     reflashes; /lib/wifi/mac80211.uc's radio_exists() checks
#     `s.macaddr == lc(macaddr)` before any phy-name fallback, so this
#     match wins regardless of enumeration order.  (This is the wiphy
#     *match* key -- unrelated to the per-boot randomized iface MAC that
#     randomize-wwan-mac writes into default_radio1.macaddr.)
#
#   band='2g', channel='6' (never 'auto')
#     This is a fullMAC driver that does not answer NL80211_CMD_GET_SURVEY,
#     so ACS has no data and hostapd hangs.  Pin the channel explicitly.
#     2.4 GHz is the deliberate default: the ESP8266/ESP32 sensor fleet is
#     2.4 GHz-only, and this driver reports "Supports VAPs: no" -- exactly one
#     BSS on one band, so the radio cannot serve both bands at once.  5 GHz
#     would be faster (see below) but would make the AP invisible to those
#     sensors, so it is opt-in rather than the default.
#
#   no `option country`
#     Setting it makes netifd emit ieee80211d=1, which stalls hostapd for 90+
#     seconds in COUNTRY_UPDATE on this chip (radxa-pkg/aic8800#98).  phy0 is
#     a self-managed wiphy anyway, so `iw reg set` is ignored by the driver.
#
#   htmode='HT20'
#     HT40 is broken on this driver *on 2.4 GHz* -- it advertises the
#     capability as "[HT40]" where hostapd's parser expects "[HT40+]"/
#     "[HT40-]".  HT20 is therefore the only safe width for the 2.4 GHz
#     default above.
#
# ---------------------------------------------------------------------------
# Optional: 5 GHz.  Measured on this hardware 2026-09-19 (kernel 6.18.44),
# swap the three radio0 lines below to:
#     band='5g'  channel='36'  htmode='HT40'
# ch36 is the lowest non-DFS channel, so there is no radar-detection wait.
# The HT40 parser bug above does NOT reproduce on 5 GHz: hostapd goes
# UNINITIALIZED->HT_SCAN->ENABLED and `iw dev` reports "width: 40 MHz,
# center1: 5190 MHz".  Measured 111 Mbit/s down / 110 Mbit/s up (iperf3 TCP)
# and 0.95 ms RTT, versus 65 Mbit/s advertised and 37 ms on 2.4 GHz HT20.
#
# The trade-off, and why this is not the default: the 2.4 GHz-only ESP8266/
# ESP32 sensor fleet cannot see a 5 GHz BSS, and this radio cannot run both
# bands simultaneously ("Supports VAPs: no").
#
# NOT VHT80/HE80 (yet).  The chip advertises VHT and HE capability blocks, so
# 802.11ac/ax ought to be reachable, but it could not be tested on the
# currently-flashed image: that image predates this repo and carries the
# *basic* wpad, whose hostapd has no CONFIG_IEEE80211AC/AX and rejects
# vht_oper_chwidth with "unknown configuration item", after which
# hostapd.add_iface fails and the radio does not come up at all.  config.seed
# now forces the full wpad-mbedtls; once an image built from it is flashed AND
# verified (`strings /usr/sbin/wpad | grep -x ieee80211ac` must be non-empty),
# VHT80 is worth trying.  Do not switch speculatively -- if the built wpad is
# still basic, the failure mode is no AP at all rather than a slower AP.
# ---------------------------------------------------------------------------
#
#   encryption='psk2+ccmp', ieee80211w='0'
#     WPA2-CCMP only.  No WPA3/SAE and no 802.11w: the driver does not
#     implement them, and the ESP8266/ESP32 sensor fleet cannot do SAE.
#
#   ifname='wlan0'
#     iwinfo reports "Supports VAPs: no" -- the driver creates exactly one
#     netdev at attach time and cannot spawn additional virtual interfaces.
#     Pinning the name makes netifd reuse that interface instead of trying to
#     add a second one.  For the same reason there can only ever be one BSS
#     (no multi-SSID), and AP and STA modes are mutually exclusive.
#
# The SSID is deliberately distinct from the upstream ONT's own SSID.  This
# board's LAN is 192.168.3.0/24 behind a second NAT, so a client that roamed
# onto a same-named AP here would silently land on a different subnet.
#
# NO PASSPHRASE HERE.  The PSK lives in machines/switchwrt/secrets.yaml under
# `wifi.ap_psk` and is delivered at runtime by machines/switchwrt/
# deploy-secrets.sh -> /usr/sbin/switchwrt-apply-secrets, which sets the key
# and clears the disabled flag below.  Consequently the AP is fully
# configured but DOWN until secrets are deployed -- deliberate, so the image
# can never come up as an open AP.  Recover over the wired LAN (eth0 is a
# br-lan member, so ssh root@192.168.3.1 works with the baked public keys).
#
# To change the passphrase later, edit sops and re-deploy -- no image rebuild:
#   sops machines/switchwrt/secrets.yaml
#   ./machines/switchwrt/deploy-secrets.sh <host>
#
# To change the SSID later:
#   uci set wireless.default_radio0.ssid='...'
#   uci commit wireless && wifi reload
#
# To use the radio as a client (STA) instead -- verified working on this
# hardware, but note the chip cannot do AP and STA at the same time:
#   uci set wireless.default_radio0.mode='sta'
#   uci set wireless.default_radio0.network='wwan'
#   uci set wireless.default_radio0.ssid='<upstream ssid>'
#   uci set wireless.default_radio0.key='<upstream psk>'
#   uci set wireless.default_radio0.disabled='0'
#   uci commit wireless && wifi reload

# /etc/init.d/boot runs `wifi config` and kmodloader (which fires the
# ieee80211 hotplug, running `wifi config` again) *before* uci-defaults, so a
# radio0 section auto-generated by /lib/wifi/mac80211.uc already exists by the
# time we get here.  Strip what it writes that we must not inherit: the
# unstable path=/phy= match keys.  (mac80211.uc also sets disabled='1' on the
# iface whenever board.json carries no wlan defaults, which is our case --
# we keep that off state deliberately and set it explicitly below.)
uci -q delete wireless.radio0.path
uci -q delete wireless.radio0.phy
uci -q delete wireless.radio0.country

uci set wireless.radio0=wifi-device
uci set wireless.radio0.type='mac80211'
uci set wireless.radio0.macaddr='94:ba:06:49:af:40'
uci set wireless.radio0.band='2g'
uci set wireless.radio0.channel='6'
uci set wireless.radio0.htmode='HT20'
uci set wireless.radio0.disabled='0'

uci set wireless.default_radio0=wifi-iface
uci set wireless.default_radio0.device='radio0'
uci set wireless.default_radio0.network='lan'
uci set wireless.default_radio0.mode='ap'
uci set wireless.default_radio0.ifname='wlan0'
uci set wireless.default_radio0.ssid='switchboard-owrt'
uci set wireless.default_radio0.encryption='psk2+ccmp'
uci set wireless.default_radio0.ieee80211w='0'
# No key= and disabled=1: switchwrt-apply-secrets supplies the PSK and
# enables the radio.  See the header note.
uci set wireless.default_radio0.disabled='1'

# Drop the duplicate radio2 section.  Only two PHYs exist on this board:
# phy1 = the built-in SDIO aic8800 (mac 94:ba:06:49:af:40, claimed by radio0)
# and phy2 = the USB rtl8xxxu dongle (mac 00:e0:4c:04:86:6a, claimed by
# radio1).  `wifi detect` can additionally emit a radio2 keyed on the dongle's
# USB *path* ('platform/soc/4200000.usb/usb2/2-1/2-1:1.0') -- i.e. a second
# entry for hardware radio1 already owns.  macaddr matching wins, so radio2
# can never come up, but it ships the stock ssid='OpenWrt' with
# encryption='none' and clutters LuCI, so remove it if present.
uci -q delete wireless.default_radio2
uci -q delete wireless.radio2

uci commit wireless

exit 0
