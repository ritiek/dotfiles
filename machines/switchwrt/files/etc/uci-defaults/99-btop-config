#!/bin/sh
# Default btop settings, mirroring modules/home/btop.nix on the NixOS fleet.
# Written by a first-boot script instead of shipping files/root/... because
# the ImageBuilder copies files/ with its directory modes, which would widen
# /root from 0750 to 0755. Left alone if a config already exists; btop
# rewrites this file with its full option set on exit. The dracula theme
# comes with the btop package (/usr/share/btop/themes).
conf=/root/.config/btop/btop.conf
[ -e "$conf" ] && exit 0
mkdir -p "${conf%/*}"
cat > "$conf" <<'EOF'
color_theme = "dracula"
vim_keys = True
cpu_graph_lower = "iowait"
proc_sorting = "memory"
net_auto = False
EOF
exit 0
