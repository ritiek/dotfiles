+package utils
+
+import (
+	"slices"
+	"strings"
+
+	"github.com/bytedance/sonic"
+	"github.com/maximhq/bifrost/core/schemas"
+)
+
+// reasoningEffortOrder ranks the reasoning effort levels, lowest first.
+var reasoningEffortOrder = []string{"none", "minimal", "low", "medium", "high", "xhigh", "max"}
+
+// SortReasoningEfforts orders effort levels lowest first, whatever order the upstream
+// listed them in; levels outside reasoningEffortOrder keep their place at the end.
+func SortReasoningEfforts(efforts []string) {
+	rank := func(effort string) int {
+		if i := slices.Index(reasoningEffortOrder, strings.ToLower(effort)); i >= 0 {
+			return i
+		}
+		return len(reasoningEffortOrder)
+	}
+	slices.SortStableFunc(efforts, func(a, b string) int { return rank(a) - rank(b) })
+}
+
+// DecodeOptional decodes an optional upstream model metadata field. It returns nil when
+// the field is absent or has an unexpected shape, so one odd field never fails a listing.
+func DecodeOptional[T any](raw []byte) *T {
+	if len(raw) == 0 || string(raw) == "null" {
+		return nil
+	}
+	var value T
+	if sonic.Unmarshal(raw, &value) != nil {
+		return nil
+	}
+	return &value
+}
+
+// catalogLimit and catalogCapabilities are the model metadata of catalogs that nest it differently:
+// GitHub Copilot ({"capabilities":{"limits":{...},"supports":{"reasoning_effort":[...]}}})
+// and OpenCode Go ({"limit":{"context","output"},"capabilities":{"reasoning":{"effort":[...]}}}).
+type catalogLimit struct {
+	Context *int `json:"context"`
+	Output  *int `json:"output"`
+}
+
+type catalogCapabilities struct {
+	Limits *struct {
+		MaxContextWindowTokens *int `json:"max_context_window_tokens"`
+		MaxOutputTokens        *int `json:"max_output_tokens"`
+	} `json:"limits"`
+	Supports *struct {
+		ReasoningEffort []string `json:"reasoning_effort"`
+	} `json:"supports"`
+	Reasoning *struct {
+		Effort []string `json:"effort"`
+	} `json:"reasoning"`
+}
+
+// ApplyCatalogMetadata fills the context size, output limit and reasoning efforts a model
+// still lacks from an upstream entry's raw "limit" and "capabilities" fields.
+func ApplyCatalogMetadata(entry *schemas.Model, limitRaw, capabilitiesRaw []byte) {
+	if entry == nil {
+		return
+	}
+	context, output := (*int)(nil), (*int)(nil)
+	var efforts []string
+	if limit := DecodeOptional[catalogLimit](limitRaw); limit != nil {
+		context, output = limit.Context, limit.Output
+	}
+	if caps := DecodeOptional[catalogCapabilities](capabilitiesRaw); caps != nil {
+		if caps.Limits != nil {
+			if context == nil {
+				context = caps.Limits.MaxContextWindowTokens
+			}
+			if output == nil {
+				output = caps.Limits.MaxOutputTokens
+			}
+		}
+		if caps.Supports != nil {
+			efforts = caps.Supports.ReasoningEffort
+		}
+		if len(efforts) == 0 && caps.Reasoning != nil {
+			efforts = caps.Reasoning.Effort
+		}
+	}
+	if entry.ContextLength == nil {
+		entry.ContextLength = context
+	}
+	if entry.MaxOutputTokens == nil {
+		entry.MaxOutputTokens = output
+	}
+	if entry.Reasoning == nil && len(efforts) > 0 {
+		efforts = slices.Clone(efforts)
+		SortReasoningEfforts(efforts)
+		entry.Reasoning = &schemas.ModelReasoning{SupportedEfforts: efforts}
+	}
+}
+
+// ApplyDisplayName names a custom provider's model "<display_name>/<upstream name>",
+// using the model ID when the upstream gave no name.
+func ApplyDisplayName(model *schemas.Model, cfg *schemas.CustomProviderConfig) {
+	if model == nil || cfg == nil || cfg.DisplayName == "" {
+		return
+	}
+	name := model.ID
+	if _, id, ok := strings.Cut(model.ID, "/"); ok {
+		name = id
+	}
+	if model.Name != nil && *model.Name != "" {
+		name = *model.Name
+	}
+	model.Name = schemas.Ptr(cfg.DisplayName + "/" + name)
+}
+
+// ApplyDisplayNames applies ApplyDisplayName to every model in a listing.
+func ApplyDisplayNames(response *schemas.BifrostListModelsResponse, cfg *schemas.CustomProviderConfig) {
+	if response == nil {
+		return
+	}
+	for i := range response.Data {
+		ApplyDisplayName(&response.Data[i], cfg)
+	}
+}
