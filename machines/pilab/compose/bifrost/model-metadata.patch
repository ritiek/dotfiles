@@ -0,0 +1,132 @@
+package openai
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/bytedance/sonic"
+	providerUtils "github.com/maximhq/bifrost/core/providers/utils"
+	"github.com/maximhq/bifrost/core/schemas"
+	"github.com/stretchr/testify/require"
+	"github.com/valyala/fasthttp"
+)
+
+func TestListModelsKeepsUpstreamMetadata(t *testing.T) {
+	t.Parallel()
+
+	body := `{"object":"list","data":[
+		{"id":"stepfun/step-3.7-flash:free","name":"StepFun: Step 3.7 Flash (free)","context_length":256000,
+		 "architecture":{"modality":"text+image->text","input_modalities":["text","image"],"output_modalities":["text"],"instruct_type":null},
+		 "top_provider":{"context_length":256000,"max_completion_tokens":230400,"is_moderated":false},
+		 "supported_parameters":["reasoning_effort","tools"],
+		 "reasoning":{"mandatory":true,"supported_efforts":["high","medium","low"]}},
+		{"id":"big-pickle","object":"model","owned_by":"opencode","name":"Big Pickle","context_length":200000,"max_completion_tokens":32000,
+		 "reasoning":{"supported_efforts":["high","turbo","low"]}},
+		{"id":"odd","reasoning":true,"architecture":"text","top_provider":[]},
+		{"id":"gpt-5","owned_by":"openai","context_window":128000}
+	]}`
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = w.Write([]byte(body))
+	}))
+	defer server.Close()
+
+	response, bifrostErr := ListModelsByKey(
+		schemas.NewBifrostContext(context.Background(), schemas.NoDeadline),
+		&fasthttp.Client{},
+		server.URL,
+		schemas.Key{Models: schemas.WhiteList{"*"}},
+		false,
+		nil,
+		schemas.ModelProvider("nous"),
+		false,
+		false,
+	)
+	require.Nil(t, bifrostErr)
+	require.Len(t, response.Data, 4)
+	models := map[string]schemas.Model{}
+	for _, model := range response.Data {
+		models[model.ID] = model
+	}
+
+	nous := models["nous/stepfun/step-3.7-flash:free"]
+	require.Equal(t, "StepFun: Step 3.7 Flash (free)", *nous.Name)
+	require.Equal(t, 256000, *nous.ContextLength)
+	require.Equal(t, 230400, *nous.MaxOutputTokens)
+	require.Equal(t, 230400, *nous.TopProvider.MaxCompletionTokens)
+	require.Equal(t, []string{"text", "image"}, nous.Architecture.InputModalities)
+	// Upstream listed them highest first; Bifrost reports them lowest first.
+	require.Equal(t, []string{"low", "medium", "high"}, nous.Reasoning.SupportedEfforts)
+	require.True(t, *nous.Reasoning.Mandatory)
+	require.Equal(t, []string{"reasoning_effort", "tools"}, nous.SupportedParameters)
+
+	// Flat max_completion_tokens is also exposed as top_provider for OpenRouter-style readers.
+	pickle := models["nous/big-pickle"]
+	require.Equal(t, "Big Pickle", *pickle.Name)
+	require.Equal(t, 200000, *pickle.ContextLength)
+	require.Equal(t, 32000, *pickle.MaxOutputTokens)
+	require.Equal(t, 32000, *pickle.TopProvider.MaxCompletionTokens)
+	require.Equal(t, []string{"low", "high", "turbo"}, pickle.Reasoning.SupportedEfforts)
+
+	// Unexpected shapes of optional fields are dropped instead of failing the listing.
+	odd := models["nous/odd"]
+	require.Nil(t, odd.Reasoning)
+	require.Nil(t, odd.Architecture)
+	require.Nil(t, odd.TopProvider)
+
+	plain := models["nous/gpt-5"]
+	require.Nil(t, plain.Name)
+	require.Nil(t, plain.TopProvider)
+	require.Equal(t, 128000, *plain.ContextLength)
+
+	providerUtils.ApplyDisplayNames(response, &schemas.CustomProviderConfig{DisplayName: "Nous Portal"})
+	require.Equal(t, "Nous Portal/StepFun: Step 3.7 Flash (free)", *response.Data[0].Name)
+	require.Equal(t, "Nous Portal/gpt-5", *response.Data[3].Name)
+
+	// The /openai drop-in listing carries the same metadata.
+	out, err := sonic.Marshal(ToOpenAIListModelsResponse(response).Data[0])
+	require.NoError(t, err)
+	require.JSONEq(t, `{"id":"nous/stepfun/step-3.7-flash:free","object":"model","owned_by":"",
+		"name":"Nous Portal/StepFun: Step 3.7 Flash (free)","context_window":256000,"context_length":256000,"max_output_tokens":230400,
+		"top_provider":{"is_moderated":false,"context_length":256000,"max_completion_tokens":230400},
+		"architecture":{"modality":"text+image->text","input_modalities":["text","image"],"output_modalities":["text"]},
+		"reasoning":{"mandatory":true,"supported_efforts":["low","medium","high"]},
+		"supported_parameters":["reasoning_effort","tools"]}`, string(out))
+}
+
+func TestDisplayNameNeedsCustomProviderSetting(t *testing.T) {
+	t.Parallel()
+
+	response := &schemas.BifrostListModelsResponse{Data: []schemas.Model{{ID: "openai/gpt-5", Name: schemas.Ptr("GPT-5")}}}
+	providerUtils.ApplyDisplayNames(response, nil)
+	providerUtils.ApplyDisplayNames(response, &schemas.CustomProviderConfig{})
+	require.Equal(t, "GPT-5", *response.Data[0].Name)
+}
+
+func TestCatalogMetadataShapes(t *testing.T) {
+	t.Parallel()
+
+	var response OpenAIListModelsResponse
+	require.NoError(t, sonic.Unmarshal([]byte(`{"object":"list","data":[
+		{"id":"claude-opus-5.5","name":"Claude Opus 5.5","capabilities":{"limits":{"max_context_window_tokens":1000000,"max_output_tokens":128000},
+		 "supports":{"reasoning_effort":["max","low","high"],"tool_calls":true}}},
+		{"id":"kimi-k3.1-pro","name":"Kimi K3.1 Pro","limit":{"context":1048576,"output":65536},
+		 "capabilities":{"tools":{"supported":true},"reasoning":{"supported":true,"effort":["low","high","max"]}}},
+		{"id":"plain","capabilities":"text"}
+	]}`), &response))
+
+	copilot := response.Data[0].toBifrostModel("copilot/claude-opus-5.5")
+	require.Equal(t, 1000000, *copilot.ContextLength)
+	require.Equal(t, 128000, *copilot.TopProvider.MaxCompletionTokens)
+	require.Equal(t, []string{"low", "high", "max"}, copilot.Reasoning.SupportedEfforts)
+
+	gogo := response.Data[1].toBifrostModel("opencodego/kimi-k3.1-pro")
+	require.Equal(t, 1048576, *gogo.ContextLength)
+	require.Equal(t, 65536, *gogo.MaxOutputTokens)
+	require.Equal(t, []string{"low", "high", "max"}, gogo.Reasoning.SupportedEfforts)
+
+	plain := response.Data[2].toBifrostModel("x/plain")
+	require.Nil(t, plain.ContextLength)
+	require.Nil(t, plain.Reasoning)
+}
