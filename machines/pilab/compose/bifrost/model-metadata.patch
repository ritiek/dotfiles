@@ -0,0 +1,48 @@
+package anthropic
+
+import (
+	"testing"
+
+	"github.com/bytedance/sonic"
+	providerUtils "github.com/maximhq/bifrost/core/providers/utils"
+	"github.com/maximhq/bifrost/core/schemas"
+	"github.com/stretchr/testify/require"
+)
+
+func TestListModelsReadsContextWindowAndEfforts(t *testing.T) {
+	t.Parallel()
+
+	// Shape served by Meridian's /v1/models.
+	body := `{"data":[
+		{"id":"claude-opus-5-5","object":"model","created":1795776949,"owned_by":"anthropic","display_name":"Claude Opus 5.5","context_window":1000000,
+		 "capabilities":{"effort":{"high":{"supported":true},"low":{"supported":true},"max":{"supported":true},"medium":{"supported":true},"xhigh":{"supported":false},"supported":true},
+		                 "thinking":{"supported":true}}},
+		{"id":"claude-haiku-4-5","display_name":"Claude Haiku 4.5","max_input_tokens":200000,"max_tokens":64000,
+		 "capabilities":{"effort":{"supported":false,"low":{"supported":true}}}},
+		{"id":"claude-odd","display_name":"","capabilities":{"effort":"yes"}}
+	],"has_more":false}`
+	var listing AnthropicListModelsResponse
+	require.NoError(t, sonic.Unmarshal([]byte(body), &listing))
+
+	response := listing.ToBifrostListModelsResponse("meridian", schemas.WhiteList{"*"}, nil, nil, false)
+	require.Len(t, response.Data, 3)
+
+	opus := response.Data[0]
+	require.Equal(t, "Claude Opus 5.5", *opus.Name)
+	require.Equal(t, 1000000, *opus.ContextLength)
+	require.Equal(t, []string{"low", "medium", "high", "max"}, opus.Reasoning.SupportedEfforts)
+
+	// Native Anthropic fields are untouched; effort levels need effort.supported.
+	haiku := response.Data[1]
+	require.Nil(t, haiku.ContextLength)
+	require.Equal(t, 200000, *haiku.MaxInputTokens)
+	require.Equal(t, 64000, *haiku.MaxOutputTokens)
+	require.Nil(t, haiku.Reasoning)
+
+	require.Nil(t, response.Data[2].Reasoning)
+
+	providerUtils.ApplyDisplayNames(response, &schemas.CustomProviderConfig{DisplayName: "Meridian"})
+	require.Equal(t, "Meridian/Claude Opus 5.5", *response.Data[0].Name)
+	// An empty upstream name falls back to the model ID.
+	require.Equal(t, "Meridian/claude-odd", *response.Data[2].Name)
+}
