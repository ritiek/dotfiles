-		Model: schemas.Model{
-			ID:              string(providerKey) + "/" + model.ID,
-			Name:            schemas.Ptr(model.DisplayName),
-			Created:         schemas.Ptr(model.CreatedAt.Unix()),
-			MaxInputTokens:  model.MaxInputTokens,
-			MaxOutputTokens: model.MaxTokens,
-			ProviderExtra:   model.Capabilities,
-		},
+		Model: model.toBifrostModel(string(providerKey) + "/" + model.ID),
+	}
+}
+
+// anthropicEffortLevels lists the effort levels a capabilities.effort block can carry, lowest first.
+var anthropicEffortLevels = []string{"low", "medium", "high", "xhigh", "max"}
+
+// toBifrostModel maps an Anthropic model onto a Bifrost model with the given ID,
+// reading the context size and the supported effort levels it advertises.
+func (model *AnthropicModel) toBifrostModel(id string) schemas.Model {
+	entry := schemas.Model{
+		ID:              id,
+		Name:            schemas.Ptr(model.DisplayName),
+		Created:         schemas.Ptr(model.CreatedAt.Unix()),
+		ContextLength:   model.ContextWindow,
+		MaxInputTokens:  model.MaxInputTokens,
+		MaxOutputTokens: model.MaxTokens,
+		ProviderExtra:   model.Capabilities,
+	}
+	// {"effort": {"supported": true, "low": {"supported": true}, ...}}
+	capabilities := providerUtils.DecodeOptional[struct {
+		Effort map[string]json.RawMessage `json:"effort"`
+	}](model.Capabilities)
+	if capabilities == nil || string(capabilities.Effort["supported"]) != "true" {
+		return entry
+	}
+	var efforts []string
+	for _, level := range anthropicEffortLevels {
+		flag := providerUtils.DecodeOptional[struct {
+			Supported bool `json:"supported"`
+		}](capabilities.Effort[level])
+		if flag != nil && flag.Supported {
+			efforts = append(efforts, level)
+		}
+	}
+	if len(efforts) > 0 {
+		entry.Reasoning = &schemas.ModelReasoning{SupportedEfforts: efforts}
 	}
+	return entry
 }
