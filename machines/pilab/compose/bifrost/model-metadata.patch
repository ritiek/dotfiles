+
+// toBifrostModel maps an upstream model, including the metadata OpenAI-compatible
+// catalogs add (name, limits, reasoning efforts), onto a Bifrost model with the given ID.
+func (model *OpenAIModel) toBifrostModel(id string) schemas.Model {
+	entry := schemas.Model{
+		ID:                  id,
+		Created:             model.Created,
+		OwnedBy:             schemas.Ptr(model.OwnedBy),
+		Name:                model.DisplayName,
+		ContextLength:       model.ContextWindow,
+		MaxInputTokens:      model.MaxInputTokens,
+		MaxOutputTokens:     model.MaxOutputTokens,
+		TopProvider:         providerUtils.DecodeOptional[schemas.TopProvider](model.TopProvider),
+		Architecture:        providerUtils.DecodeOptional[schemas.Architecture](model.Architecture),
+		Reasoning:           providerUtils.DecodeOptional[schemas.ModelReasoning](model.Reasoning),
+		SupportedParameters: model.SupportedParameters,
+	}
+	if entry.Name == nil {
+		entry.Name = model.Name
+	}
+	if entry.Reasoning != nil {
+		providerUtils.SortReasoningEfforts(entry.Reasoning.SupportedEfforts)
+	}
+	if entry.ContextLength == nil {
+		entry.ContextLength = model.ContextLength
+	}
+	if entry.ContextLength == nil && entry.TopProvider != nil {
+		entry.ContextLength = entry.TopProvider.ContextLength
+	}
+	if entry.MaxOutputTokens == nil {
+		entry.MaxOutputTokens = model.MaxCompletionTokens
+	}
+	if entry.MaxOutputTokens == nil && entry.TopProvider != nil {
+		entry.MaxOutputTokens = entry.TopProvider.MaxCompletionTokens
+	}
+	providerUtils.ApplyCatalogMetadata(&entry, model.Limit, model.Capabilities)
+	// OpenRouter-style readers take the output limit from top_provider only.
+	if entry.MaxOutputTokens != nil && (entry.TopProvider == nil || entry.TopProvider.MaxCompletionTokens == nil) {
+		if entry.TopProvider == nil {
+			entry.TopProvider = &schemas.TopProvider{}
+		}
+		entry.TopProvider.MaxCompletionTokens = entry.MaxOutputTokens
+	}
+	return entry
+}
+
+// setMetadata writes the metadata of a Bifrost model onto an outgoing OpenAI model.
+func (model *OpenAIModel) setMetadata(source *schemas.Model) {
+	model.Name = source.Name
+	model.ContextLength = source.ContextLength
+	model.MaxInputTokens = source.MaxInputTokens
+	model.MaxOutputTokens = source.MaxOutputTokens
+	model.SupportedParameters = source.SupportedParameters
+	if source.TopProvider != nil {
+		model.TopProvider, _ = sonic.Marshal(source.TopProvider)
+	}
+	if source.Architecture != nil {
+		model.Architecture, _ = sonic.Marshal(source.Architecture)
+	}
+	if source.Reasoning != nil {
+		model.Reasoning, _ = sonic.Marshal(source.Reasoning)
 	}
 }
 
