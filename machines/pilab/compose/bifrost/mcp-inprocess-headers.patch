+// withoutHTTPHeaders hides the HTTP headers of the request a call was made in (the
+// gateway's own /mcp request, for one) from an in-process server. mcp-go's server reads
+// them from ctx and, from protocol version 2026-07-28, checks Mcp-Method and Mcp-Name
+// against the message, which they describe only for the outer request.
+type withoutHTTPHeaders struct{ context.Context }
+
+func (c withoutHTTPHeaders) Value(key any) any {
+	value := c.Context.Value(key)
+	if _, ok := value.(http.Header); ok {
+		return nil
+	}
+	return value
+}
