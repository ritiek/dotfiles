# Auto-generated by compose2nix.

# Bifrost LLM gateway in front of Meridian (this host), ocfree (clawsiecats)
# and the Nous Portal proxy (radrubble). Always on rather than lazy-loaded:
# the lazy listener answers an API client with an HTML 200 while starting.
# Host networking so the container gets this host's resolver (MagicDNS) and
# 127.0.0.1:3456.
{ pkgs, lib, config, inputs, homelabMediaPath, ... }:

let
  webUIPort = 3639;
  dataDir = "${homelabMediaPath}/services/bifrost/data";

  # Built here instead of pulling maximhq/bifrost: see ./package.nix for the patch.
  bifrost = pkgs.callPackage ./package.nix { };
  image = pkgs.dockerTools.streamLayeredImage {
    name = "bifrost-local";
    tag = bifrost.version;
    # A passwd entry for the container's UID, which ssh and npm look up, and
    # /bin/sh, which uv's launchers for long install paths start with.
    contents = [
      (pkgs.dockerTools.fakeNss.override {
        extraPasswdLines = [ "bifrost:x:1000:0:Bifrost:/app/data/mcp:/sbin/nologin" ];
      })
      pkgs.bash
    ];
    extraCommands = "mkdir -m 1777 tmp";
    config = {
      Entrypoint = [ (lib.getExe bifrost) ];
      Env = [ "SSL_CERT_FILE=${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt" ];
    };
  };

  mcp = import ./mcp.nix { inherit pkgs lib inputs; };
  mcpClients = mcp.clients;
  mcpAccess = names: map (name: { mcp_client_name = name; tools_to_execute = [ "*" ]; }) names;

  # A virtual key per machine and app, so logs and usage split by them. Its
  # value is BIFROST_VK_<MACHINE>_<APP> in stack.env and bifrost_vk.key in
  # that machine's secrets (modules/home/opencode, Hermes on radrubble).
  virtualKey = machine: app: mcpClientNames: {
    id = "vk-${machine}-${app}";
    name = "${machine}-${app}";
    value = "env.BIFROST_VK_${lib.toUpper machine}_${lib.toUpper app}";
    provider_configs = [
      { provider = "meridian"; allowed_models = [ "*" ]; key_ids = [ "*" ]; weight = 1; }
      { provider = "ocfree"; allowed_models = [ "*" ]; key_ids = [ "*" ]; weight = 1; }
      # The Free plan only serves :free models; the rest fail on credits.
      { provider = "nous"; allowed_models = [ "regex:.*:free$" ]; key_ids = [ "*" ]; weight = 1; }
      { provider = "github-copilot"; allowed_models = [ "*" ]; key_ids = [ "*" ]; weight = 1; }
      # Not "*": that only admits models the catalog lists under anthropic.
      # Regex entries must match the whole name.
      { provider = "anthropic"; allowed_models = [ "regex:claude-.*" ]; key_ids = [ "*" ]; weight = 1; }
      { provider = "opencode-go"; allowed_models = [ "*" ]; key_ids = [ "*" ]; weight = 1; }
    ];
    mcp_configs = mcpAccess mcpClientNames;
  };
  opencodeMcp = lib.remove "github_readonly" (map (c: c.name) mcpClients);
  # Claude seats pooled in Meridian (../meridian/members.nix). The plain
  # provider is the pool; meridian_<member> pins a member's own profile, which
  # their key tries first and leaves for the pool when it is out of quota.
  meridian = {
    custom_provider_config = {
      base_provider_type = "anthropic";
      display_name = "Meridian";
    };
    network_config.base_url = "http://127.0.0.1:3456";
    keys = [ { name = "meridian"; value = "env.MERIDIAN_API_KEY"; models = [ "*" ]; weight = 1; } ];
  };
  poolMembers = import ../meridian/members.nix;
  memberProviders = lib.listToAttrs (map (member: lib.nameValuePair "meridian_${member}"
    (lib.recursiveUpdate meridian {
      network_config.extra_headers."x-meridian-profile" = member;
      keys = [ { name = "meridian_${member}"; value = "env.MERIDIAN_API_KEY"; models = [ "*" ]; weight = 1; } ];
    })) poolMembers);
  memberKey = member: {
    id = "vk-${member}";
    name = member;
    value = "env.BIFROST_VK_${lib.toUpper member}";
    provider_configs = map (provider: { inherit provider; allowed_models = [ "*" ]; key_ids = [ "*" ]; weight = 1; })
      [ "meridian" "meridian_${member}" ];
    mcp_configs = [ ];
  };
  memberRule = member: {
    id = "pool-${member}";
    name = "pool-${member}";
    description = "${member}'s own Claude seat first, then the pool";
    enabled = true;
    scope = "virtual_key";
    scope_id = "vk-${member}";
    cel_expression = ''provider == "meridian"'';
    targets = [ { provider = "meridian_${member}"; weight = 1; } ];
    fallbacks = [ { provider = "meridian"; } ];
    priority = 0;
  };
  opencodeMachines = [
    "alcove" "chocomelt" "clawsiecats" "deskette" "keyberry" "mishy"
    "nixstation" "pilab" "radrubble" "rig" "switchboard"
  ];
  # Responses requests (Hermes) for providers that only serve chat
  # completions: Bifrost converts them when responses isn't allowed.
  chatOnly = {
    list_models = true;
    chat_completion = true;
    chat_completion_stream = true;
  };

  # Every secret is an env.VAR reference, resolved from the env files below.
  # Default "split" source_of_truth: dashboard edits survive restarts until
  # the matching entry here changes; entries removed here stay in config.db.
  configJson = pkgs.writeText "bifrost-config.json" (builtins.toJSON {
    "$schema" = "https://www.getbifrost.ai/schema";
    encryption_key = "env.BIFROST_ENCRYPTION_KEY";
    client = {
      enforce_auth_on_inference = true;
      disable_content_logging = true;
      log_retention_days = 14;
      # MCP tools reach clients only through /mcp; injected into every chat
      # request they would arrive as tool calls the client cannot run.
      mcp_disable_auto_tool_inject = true;
      mcp_tool_execution_timeout = 120;
      # Needed for the Bifrost MCP (mcp.nix's bifrost_admin); its tool calls
      # run in process as if sent to this address.
      bifrost_url = "http://pilab.lion-zebra.ts.net:${toString webUIPort}";
      # Deleted keys still have log rows; keep them out of the logs' filter lists.
      hide_deleted_virtual_keys_in_filters = true;
    };
    mcp.client_configs = mcpClients;
    # Absolute: relative paths resolve against the working directory, not the app-dir.
    config_store = { enabled = true; type = "sqlite"; config.path = "/app/data/config.db"; };
    logs_store = { enabled = true; type = "sqlite"; config.path = "/app/data/logs.db"; };
    governance = {
      auth_config = {
        is_enabled = true;
        admin_username = "env.BIFROST_ADMIN_USERNAME";
        admin_password = "env.BIFROST_ADMIN_PASSWORD";
      };
      virtual_keys = map (m: virtualKey m "opencode" opencodeMcp) opencodeMachines ++ [
        # Hermes on radrubble: the MCP servers it used to run itself, GitHub read-only.
        (virtualKey "radrubble" "hermes" [
          "github_readonly" "indmoney" "context7" "nixos" "paperless" "kindly_web_search" "playwright_alcove"
        ])
      ] ++ map memberKey poolMembers;
      routing_rules = map memberRule poolMembers ++ [ {
        # OpenCode's opencode-claude-auth sends bare IDs (claude-opus-5-5),
        # which the catalog would route to Meridian or Copilot; its requests
        # carry the caller's Claude login, so they go to anthropic as is.
        id = "claude-code-passthrough";
        name = "claude-code-passthrough";
        enabled = true;
        scope = "global";
        cel_expression = ''"x-app" in headers && headers["x-app"] == "cli"'';
        targets = [ { provider = "anthropic"; weight = 1; } ];
        priority = 0;
      } ];
    };
    # display_name (from the patch) lists models as "<display_name>/<upstream name>".
    providers = memberProviders // {
      # No key of its own: Claude Code style requests on /anthropic (OpenCode's
      # opencode-claude-auth) carry the caller's Claude login, which Bifrost
      # passes on, so each machine uses its own subscription.
      anthropic.keys = [ ];
      inherit meridian;
      ocfree = {
        custom_provider_config = {
          base_provider_type = "openai";
          display_name = "OpenCode Free";
          allowed_requests = chatOnly;
          request_path_overrides = {
            chat_completion = "/opencode/chat/completions";
            chat_completion_stream = "/opencode/chat/completions";
          };
        };
        network_config = {
          base_url = "http://clawsiecats.lion-zebra.ts.net:9997";
          allow_private_network = true;
        };
        keys = [ { name = "ocfree"; value = "env.OCFREE_KEY"; models = [ "*" ]; weight = 1; } ];
      };
      # hermes-nous-proxy attaches the OAuth token and accepts any bearer.
      nous = {
        custom_provider_config = {
          base_provider_type = "openai";
          display_name = "Nous Portal";
          allowed_requests = chatOnly;
        };
        network_config = {
          base_url = "http://radrubble.lion-zebra.ts.net:8645";
          allow_private_network = true;
        };
        keys = [ { name = "nous"; value = "unused"; models = [ "*" ]; weight = 1; } ];
      };
      # OpenCode Go subscription (the key OpenCode on mishy is signed in with),
      # built in: it sends the x-opencode-session Go requires, the client's or
      # one of its own. Its OpenAI endpoint serves every text model, translating
      # for those whose native API is another. Go also refuses a generic HTTP
      # library's User-Agent.
      opencode-go = {
        network_config = {
          base_url = "https://opencode.ai/inference/go/openai";
          extra_headers."User-Agent" = "bifrost-gateway/${bifrost.version}";
        };
        keys = [ { name = "opencode-go"; value = "env.OPENCODE_GO_API_KEY"; models = [ "*" ]; weight = 1; } ];
      };
      # Built in: sends a fine-grained PAT to Copilot as is, with the editor
      # headers, Claude models to /v1/messages and the rest to the endpoint each
      # serves. base_url is the account's plan host (copilot_internal/user's
      # endpoints.api); it also makes copilot-initiator.patch match.
      github-copilot = {
        network_config.base_url = "https://api.individual.githubcopilot.com";
        keys = [ { name = "copilot-pat"; value = "env.COPILOT_PAT"; models = [ "*" ]; weight = 1; } ];
      };
    };
  });
in
{
  sops.secrets."compose/bifrost.env" = {
    sopsFile = ./stack.env;
    format = "dotenv";
    restartUnits = [ "docker-bifrost.service" ];
  };
  # MERIDIAN_API_KEY is read from Meridian's own env file.
  sops.secrets."compose/meridian.env".restartUnits = [ "docker-bifrost.service" ];

  networking.firewall.allowedTCPPorts = [ webUIPort ];

  # The fixed stdio MCP commands (mcp.nix), repointed at each deploy's wrappers.
  systemd.tmpfiles.rules = [ "d ${mcp.commandDir} 0755 root root -" ]
    ++ lib.mapAttrsToList (name: wrapper: "L+ ${mcp.commandDir}/${name} - - - - ${wrapper}") mcp.wrappers;

  # Runtime
  virtualisation.docker = {
    enable = true;
    autoPrune.enable = true;
  };
  virtualisation.oci-containers.backend = "docker";

  # Containers
  virtualisation.oci-containers.containers."bifrost" = {
    image = "${image.imageName}:${image.imageTag}";
    imageStream = image;
    cmd = [ "-app-dir" "/app/data" "-host" "0.0.0.0" "-port" (toString webUIPort) ];
    environment = {
      "GOMEMLIMIT" = "384MiB";
    };
    environmentFiles = [
      config.sops.secrets."compose/bifrost.env".path
      config.sops.secrets."compose/meridian.env".path
    ];
    # UID 1000 must own dataDir, as with the upstream image.
    user = "1000:0";
    workdir = "/app/data";
    volumes = [
      "${dataDir}:/app/data:rw"
      "${configJson}:/app/data/config.json:ro"
      # The stdio MCP commands, their wrappers and what those run (./mcp.nix).
      "${mcp.commandDir}:${mcp.commandDir}:ro"
      "/nix/store:/nix/store:ro"
    ];
    log-driver = "journald";
    autoStart = false;
    extraOptions = [
      "--network=host"
    ];
    labels = {
      "homepage.description" = "LLM gateway";
      "homepage.group" = "Services";
      "homepage.href" = "http://pilab.lion-zebra.ts.net:${toString webUIPort}";
      # No bifrost entry in Homepage's icon sets; Bifrost serves its own.
      "homepage.icon" = "http://pilab.lion-zebra.ts.net:${toString webUIPort}/favicon.ico";
      "homepage.name" = "Bifrost";
    };
  };
  systemd.services."docker-bifrost" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    unitConfig.RequiresMountsFor = [
      dataDir
    ];
    partOf = [ "docker-compose-bifrost-root.target" ];
    wantedBy = [ "docker-compose-bifrost-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-bifrost-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
  };
}
