+// setCopilotInitiator sends GitHub Copilot the x-initiator its own clients send: "user" for a
+// request that ends with the user's message, "agent" for one an agent makes on its own, such as
+// after a tool call. Copilot counts only "user" requests as premium requests.
+func setCopilotInitiator(ctx *schemas.BifrostContext, config *schemas.ProviderConfig, userTurn bool) {
+	if config == nil || !strings.Contains(config.NetworkConfig.BaseURL, ".githubcopilot.com") {
+		return
+	}
+	initiator := "agent"
+	if userTurn {
+		initiator = "user"
+	}
+	existing, _ := ctx.Value(schemas.BifrostContextKeyExtraHeaders).(map[string][]string)
+	headers := make(map[string][]string, len(existing)+1)
+	for name, values := range existing {
+		headers[name] = values
+	}
+	headers["x-initiator"] = []string{initiator}
+	ctx.SetValue(schemas.BifrostContextKeyExtraHeaders, headers)
+}
+
+func chatUserTurn(request *schemas.BifrostChatRequest) bool {
+	return request != nil && len(request.Input) > 0 && request.Input[len(request.Input)-1].Role == schemas.ChatMessageRoleUser
+}
+
+func responsesUserTurn(request *schemas.BifrostResponsesRequest) bool {
+	if request == nil || len(request.Input) == 0 {
+		return true
+	}
+	last := request.Input[len(request.Input)-1]
+	return last.Role != nil && *last.Role == schemas.ResponsesInputMessageRoleUser &&
+		(last.Type == nil || *last.Type == schemas.ResponsesMessageTypeMessage)
+}
