# Auto-generated by compose2nix.

# Forwards Frigate (chocomelt) alerts from the mosquitto broker to ntfy.
# The ntfy token has to sit in a header inside a list, which frigate-notify
# can't take from env vars, so config.yml is rendered by a sops template.
{ pkgs, lib, config, homelabMediaPath, ... }:

{
  sops.secrets = lib.listToAttrs (map
    (key: lib.nameValuePair "compose/frigate-notify/${key}" {
      sopsFile = ./secrets.yaml;
      inherit key;
    })
    [ "frigate_username" "frigate_password" "ntfy_token" ]);

  sops.templates."frigate-notify.yml" = {
    restartUnits = [ "docker-frigate-notify.service" ];
    content = ''
      # Frigate only creates review items for cameras with recording on, and
      # chocomelt has it off, so "reviews" mode would never fire.
      app:
        mode: events
      frigate:
        server: http://chocomelt.lion-zebra.ts.net
        public_url: http://chocomelt.lion-zebra.ts.net
        username: ${config.sops.placeholder."compose/frigate-notify/frigate_username"}
        password: ${config.sops.placeholder."compose/frigate-notify/frigate_password"}
        mqtt:
          enabled: true
          server: localhost
          port: 1883
          clientid: frigate-notify
      alerts:
        general:
          notify_once: true
        ntfy:
          enabled: true
          server: http://localhost:8894
          topic: frigate
          # Default action links to a clip, which doesn't exist with recording off.
          headers:
            - Authorization: Bearer ${config.sops.placeholder."compose/frigate-notify/ntfy_token"}
            - X-Click: http://chocomelt.lion-zebra.ts.net/explore?event_id={{ .ID }}
            - X-Actions: view, Open in Frigate, http://chocomelt.lion-zebra.ts.net/explore?event_id={{ .ID }}, clear=true
    '';
  };

  # Runtime
  virtualisation.docker = {
    enable = true;
    autoPrune.enable = true;
  };
  virtualisation.oci-containers.backend = "docker";

  # Containers
  virtualisation.oci-containers.containers."frigate-notify" = {
    image = "ghcr.io/0x2142/frigate-notify:v0.5.4";
    environment = {
      "TZ" = config.time.timeZone;
    };
    volumes = [
      "${config.sops.templates."frigate-notify.yml".path}:/app/config.yml:ro"
    ];
    log-driver = "journald";
    autoStart = false;
    extraOptions = [
      "--network=host"
    ];
  };
  systemd.services."docker-frigate-notify" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    unitConfig.ConditionPathIsMountPoint = homelabMediaPath;
    partOf = [ "docker-compose-frigate-notify-root.target" ];
    wantedBy = [ "docker-compose-frigate-notify-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-frigate-notify-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
  };
}
